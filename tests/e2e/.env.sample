# URL del editor ACD (carpeta public/)
ACD_E2E_BASE_URL="http://127.0.0.1:18085/"

# Usuarios de prueba, uno por rol. Nunca usuarios reales.
ACD_E2E_DEVELOPER_USER="e2e_developer"
ACD_E2E_EDITOR_USER="e2e_editor"
ACD_E2E_PASSWORD="cambia-esta-contraseña"

# Estructura donde se crean y borran contenidos de prueba. Necesita un campo
# de fichero y un campo de colección o de contenido relacionado.
ACD_E2E_STRUCTURE="abonos"
# Estructura en la que se buscan contenidos para relacionar
ACD_E2E_RELATED_STRUCTURE="menu"
# Texto que debe dar resultados al buscar en ACD_E2E_RELATED_STRUCTURE
ACD_E2E_RELATED_SEARCH="movistar"

# Número máximo de estructuras que se recorren en las pruebas de navegación
ACD_E2E_MAX_STRUCTURES=20
